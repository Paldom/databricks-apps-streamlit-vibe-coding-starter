{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre-bash-reminders.py"
          }
        ],
        "description": "Reminders for git push and long-lived streamlit commands"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post-edit-python-check.py"
          }
        ],
        "description": "Syntax check and print() reminder for edited Python files"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/dpal/.ai-dev-kit/repo/.claude-plugin/check_update.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
